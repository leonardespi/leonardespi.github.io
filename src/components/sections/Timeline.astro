---
export interface TimelineItem {
  period: string;
  role: string;
  org: string;
  orgUrl?: string;
  location?: string;
  current?: boolean;
  bullets: string[];
  tags?: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {items.map((item, i) => (
    <li class={`timeline-item ${item.current ? 'timeline-item--current' : ''}`}>
      <!-- Left: period + connector -->
      <div class="timeline-left">
        <span class="timeline-period">{item.period}</span>
        <div class="timeline-connector" aria-hidden="true">
          <div class="timeline-dot" />
          {i < items.length - 1 && <div class="timeline-line" />}
        </div>
      </div>

      <!-- Right: content -->
      <div class="timeline-content">
        <div class="timeline-header">
          <div>
            <h3 class="timeline-role">{item.role}</h3>
            <p class="timeline-org">
              {item.orgUrl
                ? <a href={item.orgUrl} target="_blank" rel="noopener noreferrer">{item.org}</a>
                : item.org
              }
              {item.location && <span class="timeline-location"> · {item.location}</span>}
              {item.current && <span class="timeline-badge">Current</span>}
            </p>
          </div>
        </div>

        <ul class="timeline-bullets">
          {item.bullets.map(bullet => (
            <li set:html={bullet} />
          ))}
        </ul>

        {item.tags && item.tags.length > 0 && (
          <div class="timeline-tags">
            {item.tags.map(tag => (
              <span class="tech-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0 2rem;
    position: relative;
  }

  /* ── Left column ── */
  .timeline-left {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 0.25rem;
  }

  .timeline-period {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-align: right;
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }

  .timeline-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    border: 2px solid var(--color-bg);
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .timeline-item--current .timeline-dot {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    min-height: 1.5rem;
    background: var(--color-border);
    margin-top: 4px;
  }

  /* ── Right column ── */
  .timeline-content {
    padding-bottom: 2.5rem;
  }

  .timeline-header {
    margin-bottom: 0.875rem;
  }

  .timeline-role {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .timeline-org {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .timeline-org a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .timeline-org a:hover {
    opacity: 0.75;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .timeline-location {
    color: var(--color-text-muted);
  }

  .timeline-badge {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.1em 0.5em;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .timeline-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .timeline-bullets li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .timeline-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-border);
  }

  /* Strong tags inside bullets */
  .timeline-bullets li :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tech-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.15em 0.55em;
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .timeline-left {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .timeline-period {
      margin-bottom: 0;
    }

    .timeline-connector {
      flex-direction: row;
      flex: 0;
    }

    .timeline-line {
      display: none;
    }

    .timeline-content {
      padding-bottom: 2rem;
    }
  }
</style>
