---
const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub',   href: 'https://github.com/leonardespi' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/leonardespi' },
  { label: 'X / Twitter', href: 'https://x.com/leonardespi' },
];
---

<footer>
  <div class="container footer-inner">
    <p class="copyright">
      © {year} Leonardo Espinosa
    </p>
    <nav aria-label="Social links">
      <ul>
        {socials.map(({ label, href }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--color-accent);
  }
</style>
