---
import { getLangFromUrl, getSiteContent, prefix, WRITING_PATH } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const site = getSiteContent(lang);
const p = prefix(lang);
const year = new Date().getFullYear();
const { links } = site;

const footerLinks = [
  { label: site.global.nav.work,     href: `${p}/work` },
  { label: site.global.nav.services, href: `${p}/services` },
  { label: site.global.nav.writing,  href: `${p}${WRITING_PATH}` },
  { label: site.global.nav.now,      href: `${p}/now` },
];
---

<footer>
  <div class="container footer-inner">
    <div class="footer-left">
      <p class="copyright">© {year} Leonardo Espinosa</p>
      <p class="footer-tagline">{site.global.footer.tagline}</p>
      <nav aria-label="Footer links">
        <ul class="footer-nav">
          {footerLinks.map(({ label, href }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-right">
      <nav aria-label="Social links">
        <ul class="social-list">
          <li>
            <a href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href={links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          </li>
          <li>
            <a href={`mailto:${links.email}`} aria-label="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .footer-nav {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .footer-nav a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-right {
    display: flex;
    align-items: flex-end;
  }

  .social-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social-list a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-muted);
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
  }

  .social-list a:hover {
    color: var(--color-accent);
    background: var(--color-bg-muted);
  }
</style>
