---
import { getLangFromUrl, getSiteContent, getAlternateUrl, prefix, WRITING_PATH } from '../../i18n/utils';

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
  dot?: boolean;
}

interface Props {
  postLang?: 'en' | 'es';
}

const { postLang } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const site = getSiteContent(lang);
const p = prefix(lang);

const navItems: NavItem[] = [
  { label: site.global.nav.now,      href: `${p}/now`, dot: true },
  { label: site.global.nav.work,     href: `${p}/work` },
  { label: site.global.nav.services, href: `${p}/services` },
  { label: site.global.nav.writing,  href: `${p}${WRITING_PATH}` },
  { label: site.global.nav.contact,  href: `${p}/contact` },
];

const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateUrl(Astro.url);
const languages: Record<string, string> = { en: 'EN', es: 'ES' };
---

<header id="site-header">
  <div class="header-inner container">

    <!-- Logo / Name -->
    <a href={p === '' ? '/' : `${p}/`} class="logo" aria-label="Leonardo Espinosa — Home">
      <span class="logo-name">Leonardo Espinosa</span>
      <span class="logo-title">{site.global.logo_subtitle}</span>
    </a>

    <!-- Right-side group: nav links + theme toggle -->
    <div class="header-end">

      <nav class="desktop-nav" aria-label="Primary navigation">
        <ul>
          {navItems.map(({ label, href, external, dot }) => (
            <li>
              <a
                href={href}
                class={[
                  !external && currentPath.startsWith(href) ? 'active' : '',
                  dot ? 'nav-now' : '',
                ].filter(Boolean).join(' ') || undefined}
                aria-current={!external && currentPath.startsWith(href) ? 'page' : undefined}
                {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
              >
                {dot && <span class="now-dot" aria-hidden="true"></span>}
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Language toggle — single button -->
      {postLang ? (
        <span class="lang-toggle lang-toggle--locked" aria-label={postLang === 'en' ? 'English' : 'Español'} title="Language fixed for this post">
          {languages[postLang]}
        </span>
      ) : (
        <a
          href={alternateUrl}
          class="lang-toggle"
          hreflang={lang === 'en' ? 'es' : 'en'}
          aria-label={lang === 'en' ? 'Switch to Español' : 'Switch to English'}
        >
          {languages[lang]}
        </a>
      )}

      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="icon-moon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
        <span class="icon-sun" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </span>
      </button>

    </div>

    <!-- Mobile menu trigger -->
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      <span class="burger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

  </div>
</header>

<!-- Mobile nav — native <dialog> for free focus trap + Escape key + backdrop -->
<dialog id="mobile-menu" aria-label="Navigation menu">
  <div class="mobile-nav-inner">

    <div class="mobile-nav-header">
      <a href={p === '' ? '/' : `${p}/`} class="logo" aria-label="Leonardo Espinosa — Home">
        <span class="logo-name">Leonardo Espinosa</span>
        <span class="logo-title">{site.global.logo_subtitle}</span>
      </a>
      <button
        class="menu-close"
        id="menu-close"
        aria-label="Close navigation menu"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        {navItems.map(({ label, href, external, dot }) => (
          <li>
            <a
              href={href}
              class={[
                !external && currentPath.startsWith(href) ? 'active' : '',
                dot ? 'nav-now' : '',
              ].filter(Boolean).join(' ') || undefined}
              aria-current={!external && currentPath.startsWith(href) ? 'page' : undefined}
              {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            >
              {dot && <span class="now-dot" aria-hidden="true"></span>}
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-nav-footer">
      {postLang ? (
        <span class="mobile-lang-btn mobile-lang-btn--locked" title="Language fixed for this post">{languages[postLang]}</span>
      ) : (
        <a
          href={alternateUrl}
          class="mobile-lang-btn"
          hreflang={lang === 'en' ? 'es' : 'en'}
          aria-label={lang === 'en' ? 'Switch to Español' : 'Switch to English'}
        >
          {languages[lang]}
        </a>
      )}
      <button id="mobile-theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="icon-moon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
        <span class="icon-sun" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </span>
      </button>
    </div>

  </div>
</dialog>

<style>
  /* ── Header shell ── */
  #site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-block: 1rem;
    background: color-mix(in srgb, var(--color-bg) calc(var(--scroll-pct, 0%) * 0.95), transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) calc(var(--scroll-pct, 0%)), transparent);
    backdrop-filter: blur(calc(var(--scroll-pct, 0%) * 0.08px));
    -webkit-backdrop-filter: blur(calc(var(--scroll-pct, 0%) * 0.08px));
    transition: background 0.2s, border-color 0.2s;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── Right-side group ── */
  .header-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .logo-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-accent);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* ── Desktop nav ── */
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Language toggle — single button, same shape as theme toggle ── */
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    flex-shrink: 0;
    line-height: 1;
    cursor: pointer;
  }

  .lang-toggle:hover {
    background: var(--color-bg-muted);
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .lang-toggle--locked {
    cursor: not-allowed;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  .lang-toggle--locked:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  /* ── Now dot indicator ── */
  .now-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: 0.3rem;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 450;
    color: var(--color-text-muted);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }

  .desktop-nav a:hover {
    color: var(--color-text);
    background: var(--color-bg-muted);
  }

  .desktop-nav a.active {
    color: var(--color-accent);
    font-weight: 500;
    background: var(--color-bg-muted);
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    flex-shrink: 0;
    padding: 0;
  }

  .theme-toggle:hover {
    background: var(--color-bg-muted);
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  /* ── Hamburger button ── */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    cursor: pointer;
    padding: 0;
    transition: background 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .menu-toggle:hover {
    background: var(--color-bg-muted);
    border-color: var(--color-text-muted);
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .burger span {
    display: block;
    height: 1.5px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Burger → X when open */
  .menu-toggle[aria-expanded="true"] .burger span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .burger span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle[aria-expanded="true"] .burger span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ── Mobile nav dialog ── */
  #mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--color-bg);
    overflow-y: auto;
    /* Start hidden (dialog default) */
  }

  /* Dialog open animation */
  #mobile-menu[open] {
    animation: drawer-in 0.22s ease-out both;
  }

  @keyframes drawer-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem 2rem;
    min-height: 100%;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    cursor: pointer;
    color: var(--color-text);
    transition: background 0.15s;
    padding: 0;
  }

  .menu-close:hover {
    background: var(--color-bg-muted);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-list a {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s;
    letter-spacing: -0.01em;
  }

  .mobile-nav-list a:hover,
  .mobile-nav-list a.active {
    color: var(--color-accent);
  }

  .mobile-nav-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-nav-footer .theme-toggle {
    width: 52px;
    height: 44px;
  }

  .mobile-lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .mobile-lang-btn:hover {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }

  .mobile-lang-btn--locked {
    cursor: not-allowed;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  .mobile-lang-btn--locked:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  /* ── Responsive breakpoints ── */
  @media (max-width: 640px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .logo-title {
      display: none;
    }

    #site-header .lang-toggle,
    #site-header .theme-toggle {
      display: none;
    }
  }

  @media (min-width: 641px) {
    .menu-toggle {
      display: none;
    }

    #mobile-menu {
      display: none;
    }
  }
</style>

<script>
  function initHeader() {
    // ── Scroll-driven header background ──────────────────────────
    const header = document.getElementById('site-header');
    if (header) {
      const updateScroll = () => {
        const pct = Math.min(window.scrollY / 80, 1) * 100;
        header.style.setProperty('--scroll-pct', `${pct}%`);
      };
      window.addEventListener('scroll', updateScroll, { passive: true });
      updateScroll();
    }

    // ── Theme toggle ──────────────────────────────────────────────
    const toggleTheme = () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    };

    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) themeToggle.addEventListener('click', toggleTheme);

    const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
    if (mobileThemeToggle) mobileThemeToggle.addEventListener('click', toggleTheme);

    // ── Mobile menu ───────────────────────────────────────────────
    const dialog  = document.getElementById('mobile-menu') as HTMLDialogElement | null;
    const toggle  = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');

    if (!dialog || !toggle || !closeBtn) return;

    const openMenu = () => {
      dialog.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      dialog.close();
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggle.focus();
    };

    toggle.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    // Close on nav link click (page change)
    dialog.querySelectorAll('a[href]').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close when clicking the ::backdrop (outside the inner content)
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeMenu();
    });

    // Native <dialog> already handles Escape → close, but we need to
    // sync aria-expanded and body overflow
    dialog.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  }

  document.addEventListener('astro:page-load', () => {
    initHeader();
  });
</script>
