---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../i18n/utils';

const site = getSiteContent('en');
const { pages, links } = site;
const contact = pages.contact;

const iconSvg: Record<string, string> = {
  monitor: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
  smile:   '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>',
  users:   '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
};
---

<BaseLayout title={contact.meta.title} description={contact.meta.description}>
  <div class="contact-page container--narrow container">

    <header class="contact-header">
      <p class="eyebrow">{contact.header.eyebrow}</p>
      <h1 class="contact-title">{contact.header.title}</h1>
      <p class="contact-intro">{contact.header.intro}</p>
    </header>

    <div class="contact-options">
      <p class="options-label">{contact.options.label}</p>
      <div class="option-cards">
        {contact.options.items.map((opt: any) => (
          <a href={`mailto:${links.email}?subject=${opt.subject}`} class="option-card">
            <div class="option-icon" aria-hidden="true" set:html={iconSvg[opt.icon]} />
            <h2 class="option-title">{opt.title}</h2>
            <p class="option-desc">{opt.desc}</p>
            <span class="option-cta">
              {links.email}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="contact-meta">
      {contact.meta_info.map((item: any) => (
        <div class="meta-item">
          <span class="meta-label">{item.label}</span>
          {item.is_email
            ? <a href={`mailto:${links.email}`} class="meta-link">{links.email}</a>
            : <span class="meta-value">{item.value}</span>
          }
        </div>
      ))}
    </div>

    <div class="contact-elsewhere">
      <p class="elsewhere-label">{contact.elsewhere.label}</p>
      <div class="elsewhere-links">
        <a href={links.github} target="_blank" rel="noopener noreferrer" class="elsewhere-link">
          GitHub
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="elsewhere-link">
          LinkedIn
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-block: 4rem 6rem;
  }

  .contact-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .contact-intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 440px;
  }

  .contact-options {
    margin-bottom: 3rem;
  }

  .options-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .option-cards {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  @media (min-width: 640px) {
    .option-cards {
      flex-direction: row;
    }
  }

  .option-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: 1.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .option-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.07);
  }

  .option-icon {
    color: var(--color-accent);
  }

  .option-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .option-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .option-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-top: auto;
  }

  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-bg-muted);
    border-radius: 0.75rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 480px) {
    .contact-meta {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .meta-link {
    font-size: 0.9375rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .meta-link:hover {
    text-decoration-color: var(--color-accent);
  }

  .elsewhere-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .elsewhere-links {
    display: flex;
    gap: 1.25rem;
  }

  .elsewhere-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .elsewhere-link:hover {
    color: var(--color-accent);
  }
</style>
