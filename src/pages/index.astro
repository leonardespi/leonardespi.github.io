---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import Hero from '../components/sections/Hero.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { getSiteContent, WRITING_PATH } from '../i18n/utils';

const site = getSiteContent('en');
const { pages, links, index: sections } = site;
const home = pages.home;

const { frontmatter: nowData } = await import('../content/now/en.md');
const nowWidget = nowData.widget;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

---

<BaseLayout description={home.meta.description}>
  <!-- ─── HERO ────────────────────────────────────────────────────────── -->
  {sections.hero && (
    <Hero
      variant="home"
      eyebrow={home.hero.eyebrow}
      title={home.hero.title}
      subtitle={home.hero.subtitle}
      trajectory={home.hero.trajectory}
      ctas={home.hero.ctas}
    />
  )}

  <!-- ─── WIDGETS (Available for + Now feed) ─────────────────────────── -->
  {(sections.available_for || sections.now_feed) && (
    <section class="section section--widgets">
      <div class="container">
        <div class="widgets-grid">

          {sections.available_for && (
            <div class="widget-card widget-card--available">
              <p class="available-label">{home.available_for.label}</p>
              <ul class="available-list">
                {home.available_for.items.map((item: any) => (
                  <li>
                    <span class="arrow">→</span> {item.text}
                    {item.detail && <span class="detail">{item.detail}</span>}
                  </li>
                ))}
              </ul>
              <a href={`mailto:${links.email}`} class="available-cta">
                {home.available_for.cta}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          )}

          {sections.now_feed && (
            <div class="widget-card widget-card--now">
              <div class="now-badge">
                <span class="now-pulse" aria-hidden="true"></span>
                {nowWidget.badge}
              </div>
              <div class="now-snapshot">
                {nowWidget.rows.map((row: any) => (
                  <div class="now-row">
                    <span class="now-row-label">{row.label}</span>
                    <span class="now-row-value" set:html={row.value} />
                  </div>
                ))}
              </div>
              <span class="now-updated">{nowWidget.updated}</span>
              <a href="/now" class="now-cta">{nowWidget.link}</a>
            </div>
          )}

        </div>
      </div>
    </section>
  )}

  <!-- ─── RECENT WRITING ───────────────────────────────────────────────── -->
  {sections.recent_writing && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{home.writing.title}</h2>
          <a href={WRITING_PATH} class="section-link">{home.writing.all}</a>
        </div>
        <div class="posts-list">
          {recentPosts.map((post) => (
            <a href={`${WRITING_PATH}/${post.id}`} class="post-item">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()} class="post-date">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {post.data.tags.slice(0, 2).map(tag => <Tag label={tag} />)}
              </div>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-description">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── DUAL IDENTITY ────────────────────────────────────────────────── -->
  {sections.dual_identity && (
    <section class="section section--identity">
      <div class="container">
        <div class="identity-inner">
          <div class="identity-text">
            <h2 class="section-title">{home.dual_identity.title}</h2>
            <p class="identity-copy">{home.dual_identity.copy}</p>
            <a href="/work" class="section-link">{home.dual_identity.link}</a>
          </div>
          <div class="identity-samples">
            {home.dual_identity.samples.map((s: any) => (
              <div class={`sample-card sample-card--${s.key}`}>
                {s.type === 'youtube' && s.src && (
                  <iframe
                    src={s.src}
                    class="sample-embed"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    title={s.label}
                  />
                )}
                {s.type === 'image' && s.src && (
                  <img src={s.src} alt={s.label} class="sample-image" loading="lazy" />
                )}
                <span class="sample-label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ─── FEATURED PROJECTS ────────────────────────────────────────────── -->
  {sections.featured_projects && (
    <section class="section section--muted">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Featured Projects</h2>
          <a href="/work" class="section-link">All projects →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
  {sections.cta && (
    <section class="section section--cta">
      <div class="container">
        <div class="cta-inner">
          <div>
            <h2 class="cta-title">{home.cta.title}</h2>
            <p class="cta-body">{home.cta.body}</p>
          </div>
          <div class="cta-actions">
            <Button href={links.cv} variant="primary">{home.cta.resume}</Button>
            <Button href={`mailto:${links.email}`} variant="ghost">{home.cta.contact}</Button>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── Sections ── */
  .section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .section--muted {
    background: var(--color-bg-muted);
  }

  /* ── Widget section — zero padding, panel flush to edge ── */
  .section--widgets {
    padding-block: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .widgets-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .widgets-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .widget-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--color-bg-card);
  }

  .widget-card--available {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 720px) {
    .widget-card--available {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
  }

  /* ── Available for card ── */
  .available-label {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .available-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .available-list li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .available-list li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .available-list .arrow {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .available-list .detail {
    font-size: 0.75rem;
    opacity: 0.5;
    margin-left: auto;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .available-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 0.375rem;
    text-decoration: none;
    white-space: nowrap;
    align-self: flex-start;
    transition: background 0.15s, transform 0.1s;
    letter-spacing: 0.01em;
  }

  .available-cta:hover {
    background: var(--color-accent-hover);
  }

  .available-cta:active {
    transform: scale(0.98);
  }

  /* ── Now feed card ── */
  .now-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .now-pulse {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.3; transform: scale(0.75); }
  }

  .now-snapshot {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .now-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }

  .now-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .now-row-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  .now-row-value {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .now-updated {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.45;
    font-variant-numeric: tabular-nums;
  }

  .now-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: transparent;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 0.375rem;
    text-decoration: none;
    white-space: nowrap;
    align-self: flex-start;
    transition: background 0.15s, border-color 0.15s;
  }

  .now-cta:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: var(--color-accent);
  }

  /* ── Section header ── */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    white-space: nowrap;
    transition: opacity 0.15s;
    font-weight: 500;
    text-decoration: none;
  }

  .section-link:hover {
    opacity: 0.7;
  }

  /* ── Posts — numbered editorial list ── */
  .posts-list {
    display: flex;
    flex-direction: column;
    counter-reset: posts;
  }

  .post-item {
    position: relative;
    display: block;
    padding: 1.75rem 0.75rem 1.75rem 3.25rem;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 0.2s;
    border-radius: 0.375rem;
    counter-increment: posts;
    margin-inline: -0.75rem;
  }

  .post-item::before {
    content: counter(posts, decimal-leading-zero);
    position: absolute;
    left: 0.75rem;
    top: 1.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    opacity: 0.35;
    transition: color 0.2s, opacity 0.2s;
    line-height: 1;
  }

  .post-item:hover {
    background: color-mix(in srgb, var(--color-bg-muted) 70%, transparent);
  }

  .post-item:hover::before {
    color: var(--color-accent);
    opacity: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.375rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    opacity: 0.65;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text);
    margin-bottom: 0.375rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 600;
    transition: color 0.15s;
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Dual identity ── */
  .section--identity {
    background: var(--color-bg-muted);
  }

  .identity-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .identity-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 4rem;
    }
    .identity-text {
      flex: 0 0 360px;
    }
  }

  .identity-copy {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-block: 1rem 1.5rem;
  }

  .identity-samples {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    flex: 1;
  }

  .sample-card {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .sample-card--photo {
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-bg-card));
  }

  .sample-card--illustration {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-card));
  }

  .sample-card--music {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-card));
  }

  .sample-embed,
  .sample-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
  }

  .sample-label {
    position: relative;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: color-mix(in srgb, #000 65%, transparent);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    z-index: 1;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* ── CTA ── */
  .section--cta {
    background: transparent;
    border-bottom: none;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding-block: 1rem;
  }

  @media (min-width: 768px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .cta-body {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 480px;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .cta-actions {
      width: 100%;
      flex-wrap: wrap;
    }
    .cta-actions > :global(a) {
      flex: 1 1 0;
      justify-content: center;
    }
  }
</style>
