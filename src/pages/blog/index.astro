---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ui/Tag.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year
const byYear = posts.reduce<Record<number, typeof posts>>((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

// All unique tags for filter hint
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout
  title="Blog"
  description="Writing on quality engineering, system design, AI/LLM governance, and IT architecture from the field."
>
  <div class="container container--narrow" style="padding-block: 4rem 6rem;">

    <!-- Header -->
    <header class="page-header">
      <p class="eyebrow">Blog</p>
      <h1>Writing.</h1>
      <p class="page-subtitle">
        On quality engineering, system design, AI/LLM governance, and the
        architectural decisions that determine whether systems survive at scale.
      </p>
    </header>

    <!-- Tag filters -->
    {allTags.length > 0 && (
      <div class="tag-cloud" id="tag-filters" role="group" aria-label="Filter posts by tag">
        {allTags.map(tag => (
          <button class="tag-btn" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
    )}

    <!-- Posts by year -->
    {years.map(year => (
      <section class="year-group" data-year-section>
        <h2 class="year-label" aria-label={`Posts from ${year}`}>{year}</h2>
        <ol class="post-list">
          {byYear[year].map(post => {
            const d = post.data.date;
            const dayMonth = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            return (
              <li data-post-tags={JSON.stringify(post.data.tags)}>
                <a href={`/blog/${post.id}`} class="post-row">
                  <time
                    datetime={d.toISOString()}
                    class="post-date"
                    title={d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  >
                    {dayMonth}
                  </time>
                  <div class="post-info">
                    <h3 class="post-title">{post.data.title}</h3>
                    <p class="post-description">{post.data.description}</p>
                    {post.data.tags.length > 0 && (
                      <div class="post-tags">
                        {post.data.tags.map(tag => <Tag label={tag} />)}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    {posts.length === 0 && (
      <p style="color: var(--color-text-muted); font-size: 1rem; padding-block: 2rem;">
        No posts yet. Check back soon.
      </p>
    )}

  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#tag-filters .tag-btn');
  const postItems = document.querySelectorAll<HTMLLIElement>('[data-post-tags]');
  const yearSections = document.querySelectorAll<HTMLElement>('[data-year-section]');

  let active = new Set<string>();

  function applyFilter() {
    postItems.forEach(item => {
      const tags: string[] = JSON.parse(item.dataset.postTags ?? '[]');
      const visible = active.size === 0 || tags.some(t => active.has(t));
      item.hidden = !visible;
    });

    yearSections.forEach(section => {
      const anyVisible = [...section.querySelectorAll<HTMLLIElement>('[data-post-tags]')]
        .some(item => !item.hidden);
      section.hidden = !anyVisible;
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;
      if (active.has(tag)) {
        active.delete(tag);
        btn.setAttribute('aria-pressed', 'false');
      } else {
        active.add(tag);
        btn.setAttribute('aria-pressed', 'true');
      }
      applyFilter();
    });
  });
</script>

<style>
  /* Header */
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.875rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 540px;
  }

  /* Tag filters */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 3rem;
  }

  .tag-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.2em 0.65em;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .tag-btn:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    color: var(--color-accent);
  }

  .tag-btn[aria-pressed="true"] {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .post-list li[hidden] {
    display: none;
  }

  .year-group[hidden] {
    display: none;
  }

  /* Year group */
  .year-group {
    margin-bottom: 3.5rem;
  }

  .year-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Post row */
  .post-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 0.15s;
    margin-inline: -1rem;
    padding-inline: 1rem;
    border-radius: 0.5rem;
  }

  .post-row:hover {
    background: var(--color-bg-muted);
  }

  .post-date {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.3rem;
    text-align: right;
    line-height: 1.3;
    white-space: nowrap;
  }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.3;
    transition: color 0.15s;
  }

  .post-row:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    text-align: justify;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.125rem;
  }

  @media (max-width: 480px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }

    .post-date {
      text-align: left;
      padding-top: 0;
    }
  }
</style>
