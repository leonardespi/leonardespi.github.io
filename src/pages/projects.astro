---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';

const projects = [
  {
    name: 'POLQA',
    tagline: 'LLM Output Governance & Bias Evaluation Framework',
    description:
      'A modular CLI framework for governing LLM output quality at scale. The core architectural decision was provider-agnostic design with a pluggable evaluation layer — chosen over a tightly-coupled solution because LLM ecosystems fragment rapidly and auditability requires reproducibility across model versions. Supports HuggingFace, Ollama, OpenAI, Claude, and custom endpoints.',
    outcome: 'Enforces reproducibility, cross-model comparability, and auditability — governance properties absent from most academic and commercial evaluation tooling.',
    tags: ['Python', 'LLM Governance', 'Adversarial Testing', 'HuggingFace', 'OpenAI'],
    href: 'https://polqa-framework.github.io/polqa-site/',
    featured: true,
  },
  {
    name: 'Automation Learn',
    tagline: 'Scalable QA Capability — Decoupling Knowledge from Individuals',
    description:
      'A structured curriculum designed around a specific architectural principle: quality capability should be institutionalized, not person-dependent. The decision to build opinionated learning paths over encyclopedic references was deliberate — transferable judgment scales; tool familiarity does not. Covers Selenium, Cypress, API testing, CI/CD, and test architecture.',
    outcome: 'Reduces knowledge-transfer and ramp-up time for engineers entering automation roles.',
    tags: ['Selenium', 'Cypress', 'Robot Framework', 'CI/CD', 'GitHub Actions'],
    href: 'https://github.com/leonardespi/automation-learn',
    featured: false,
  },
  {
    name: 'SynLeo',
    tagline: 'Generative AI Architecture for Creative Systems',
    description:
      'An architectural exploration of generative AI applied to music production. The key design question was whether AI functions better as a creative constraint or a generative layer — and what the system boundaries look like when the output is subjective. Covers voice modeling, lyric generation, and the governance challenges unique to AI-generated creative content.',
    outcome: 'A working model for how generative AI can be integrated into creative workflows without displacing authorship.',
    tags: ['Python', 'Generative AI', 'System Design', 'Creative Tech'],
    href: 'https://github.com/leonardespi/synleo',
    featured: false,
  },
  {
    name: 'SPA — System for Thought & Action',
    tagline: 'Information Architecture for High-Complexity Knowledge Work',
    description:
      'A personal operating system that synthesizes PARA, GTD, and SCRUM into a single coherent information architecture. The design trade-off was consistency over flexibility — a stricter schema reduces cognitive load at the cost of customization. Built for technical professionals managing concurrent projects, continuous learning, and long-horizon career decisions.',
    outcome: 'Demonstrates that information architecture principles — hierarchy, separation of concerns, clear interfaces — apply equally to knowledge management systems.',
    tags: ['Obsidian', 'Information Architecture', 'PARA', 'GTD', 'Systems Design'],
    href: 'https://github.com/leonardespi/spa',
    featured: false,
  },
  {
    name: 'Resume Builder',
    tagline: 'Structured Data → Professional Document Pipeline',
    description:
      'Enforces a clean separation between content and presentation — an architectural boundary most resume tools collapse, creating lock-in and brittle outputs. YAML as the single source of truth; PDF as a deterministic, reproducible artifact. Optimized for ATS parsing without sacrificing human readability, because both constraints must be satisfied simultaneously.',
    outcome: 'Produces documents that parse cleanly through major ATS systems and communicate clearly to human reviewers.',
    tags: ['Python', 'PDF Generation', 'CLI', 'YAML'],
    href: 'https://github.com/leonardespi/resume-builder',
    featured: false,
  },
  {
    name: 'README Wizard',
    tagline: 'Documentation as a First-Class Engineering Artifact',
    description:
      'Treats README generation as a structured pipeline problem rather than a writing task. The decision to constrain output format was intentional — open-ended documentation tools produce inconsistent results because they offer too many degrees of freedom. A minimal schema forces the four questions every README must answer: what it does, how to install it, how to use it, and how to contribute.',
    outcome: 'Reduces time to first usable documentation from hours to minutes, with consistent structure across projects.',
    tags: ['Python', 'CLI', 'Markdown', 'Documentation Design'],
    href: 'https://github.com/leonardespi/readme-wizard',
    featured: false,
  },
];
---

<BaseLayout
  title="Projects"
  description="Open-source systems and frameworks by Leonardo Espinosa — LLM governance, quality architecture, and scalable automation design."
>
  <div style="padding-block: 4rem 6rem;">

    <!-- Page header -->
    <div class="container container--narrow">
      <header style="margin-bottom: 4rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border);">
        <p class="eyebrow">Projects</p>
        <h1 style="font-family: var(--font-display); font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 1rem;">
          Systems I've designed.
        </h1>
        <p style="font-size: 1.0625rem; color: var(--color-text-muted); line-height: 1.7; max-width: 560px;">
          Open-source frameworks, tools, and architectural experiments. Each one addresses a specific
          design problem — and documents the trade-offs that shaped the solution.
        </p>
      </header>
    </div>

    <!-- Featured project -->
    {projects.filter(p => p.featured).map(project => (
      <div class="container" style="margin-bottom: 2rem;">
        <a href={project.href} class="project-featured" target="_blank" rel="noopener noreferrer">
          <div class="project-featured-inner">
            <div class="project-featured-label">Featured Project</div>
            <h2 class="project-featured-name">{project.name}</h2>
            <p class="project-featured-tagline">{project.tagline}</p>
            <p class="project-featured-description">{project.description}</p>
            {project.outcome && (
              <div class="project-outcome">
                <span class="outcome-label">Outcome</span>
                <p class="outcome-text">{project.outcome}</p>
              </div>
            )}
            <div class="project-tags">
              {project.tags.map(tag => <Tag label={tag} color="accent" />)}
            </div>
          </div>
        </a>
      </div>
    ))}

    <!-- Project grid -->
    <div class="container">
      <div class="projects-grid">
        {projects.filter(p => !p.featured).map(project => (
          <a href={project.href} class="project-card" target="_blank" rel="noopener noreferrer">
            <div class="project-card-header">
              <h3 class="project-card-name">{project.name}</h3>
              <span class="project-card-tagline">{project.tagline}</span>
            </div>
            <p class="project-card-description">{project.description}</p>
            {project.outcome && (
              <div class="project-outcome project-outcome--sm">
                <span class="outcome-label">Outcome</span>
                <p class="outcome-text">{project.outcome}</p>
              </div>
            )}
            <div class="project-tags">
              {project.tags.map(tag => <Tag label={tag} />)}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- GitHub CTA -->
    <div class="container container--narrow" style="margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--color-border);">
      <p style="font-size: 0.9375rem; color: var(--color-text-muted); margin-bottom: 1.25rem;">
        All projects are open-source. Issues, forks, and contributions welcome.
      </p>
      <Button href="https://github.com/leonardespi" variant="ghost" external={true}>
        View on GitHub →
      </Button>
    </div>

  </div>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* ── Featured ── */
  .project-featured {
    display: block;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg-card));
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: 1rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .project-featured:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px rgba(0,0,0,0.07);
    transform: translateY(-2px);
  }

  .project-featured-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .project-featured-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: 0.375rem;
    letter-spacing: -0.015em;
  }

  .project-featured-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    text-align: justify;
  }

  .project-featured-description {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    text-align: justify;
  }

  /* ── Outcome callout ── */
  .project-outcome {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.875rem 1rem;
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    border-radius: 0.5rem;
  }

  .project-outcome--sm {
    padding: 0.625rem 0.875rem;
  }

  .outcome-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-outcome-text);
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    padding: 0.2em 0.6em;
    border-radius: 0.25rem;
    align-self: flex-start;
  }

  .outcome-text {
    font-size: 0.9375rem;
    color: var(--color-outcome-text);
    line-height: 1.6;
    margin: 0;
    text-align: justify;
  }

  .project-outcome--sm .outcome-text {
    font-size: 0.875rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  /* ── Grid cards ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.75rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }

  .project-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .project-card-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
    line-height: 1.2;
  }

  .project-card-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: justify;
  }

  .project-card-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    text-align: justify;
  }
</style>
