---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import { getSiteContent } from '../i18n/utils';
import githubProjects from '../data/github-projects.json';

const site = getSiteContent('en');
const { pages, links } = site;
const work = pages.work;
const tech = work.technical;
const creative = work.creative;
const sections = work.sections;

const featuredProject = githubProjects[0];
const otherProjects   = githubProjects.slice(1);

function relativeDate(iso: string | null | undefined): string {
  if (!iso) return '';
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
  if (days < 1) return 'today';
  if (days < 7) return `${days}d ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
}
---

<BaseLayout title={work.meta.title} description={work.meta.description}>
  <div class="work-page">

    <div class="work-header container">
      <p class="eyebrow">{work.header.eyebrow}</p>
      <h1 class="work-title">{work.header.title}</h1>
      <p class="work-subtitle">{work.header.subtitle}</p>

      <div class="filter-tabs" role="tablist" aria-label="Filter work by category">
        <button class="filter-tab is-active" data-filter="all" role="tab" aria-selected="true" type="button">{work.filters.all}</button>
        <button class="filter-tab" data-filter="technical" role="tab" aria-selected="false" type="button">{work.filters.technical}</button>
        <button class="filter-tab" data-filter="photography" role="tab" aria-selected="false" type="button">{work.filters.photography}</button>
        {sections.illustration && <button class="filter-tab" data-filter="illustration" role="tab" aria-selected="false" type="button">{work.filters.illustration}</button>}
        <button class="filter-tab" data-filter="music" role="tab" aria-selected="false" type="button">{work.filters.music}</button>
      </div>
    </div>

    <!-- ── Technical ──────────────────────────────────── -->
    <section class="work-section container" data-section="technical" id="section-technical">
      <div class="work-section-label">
        <h2 class="work-section-title">{tech.title}</h2>
        <a href={links.github} class="gh-link" target="_blank" rel="noopener noreferrer">
          {tech.gh_label}
        </a>
      </div>

      {featuredProject && (
        <a href={featuredProject.homepage ?? featuredProject.url} class="tech-featured" target="_blank" rel="noopener noreferrer">
          <span class="featured-badge">{tech.featured_label}</span>
          <h3 class="tech-featured-name">{featuredProject.name}</h3>
          <div class="repo-stats">
            {featuredProject.archived && <span class="archived-badge">Archived</span>}
            <span class="stat-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {featuredProject.stars ?? 0}
            </span>
            <span class="stat-sep">·</span>
            <span class="stat-item">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M6 9v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
              {featuredProject.forks ?? 0}
            </span>
            {featuredProject.pushedAt && (
              <>
                <span class="stat-sep">·</span>
                <span class="stat-item">Updated {relativeDate(featuredProject.pushedAt)}</span>
              </>
            )}
          </div>
          <p class="tech-featured-desc">{featuredProject.description}</p>
          <div class="tech-meta">
            {featuredProject.topics?.length > 0 && (
              <div class="meta-group">
                <span class="meta-label">{tech.meta_topics}</span>
                <div class="tag-row">
                  {featuredProject.topics.slice(0, 3).map((t: string) => <Tag label={t} color="accent" />)}
                </div>
              </div>
            )}
            <div class="meta-group">
              <span class="meta-label">{tech.meta_languages}</span>
              <div class="tag-row">
                {featuredProject.languages.slice(0, 3).map((l) => (
                  <span class="lang-tag">
                    <span class="lang-dot" style={`background:${l.color}`} />
                    {l.name} <span class="lang-pct">{l.percentage}%</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </a>
      )}

      <div class="tech-grid">
        {otherProjects.map((p) => (
          <a href={p.homepage ?? p.url} class="tech-card" target="_blank" rel="noopener noreferrer">
            <div>
              <h3 class="tech-card-name">{p.name}</h3>
              <div class="repo-stats repo-stats--compact">
                {p.archived && <span class="archived-badge">Archived</span>}
                <span class="stat-item">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {p.stars ?? 0}
                </span>
                <span class="stat-sep">·</span>
                <span class="stat-item">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M6 9v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
                  {p.forks ?? 0}
                </span>
                {p.pushedAt && (
                  <>
                    <span class="stat-sep">·</span>
                    <span class="stat-item">{relativeDate(p.pushedAt)}</span>
                  </>
                )}
              </div>
            </div>
            <p class="tech-card-desc">{p.description}</p>
            <div class="tech-meta">
              {p.topics?.length > 0 && (
                <div class="meta-group">
                  <span class="meta-label">{tech.meta_topics}</span>
                  <div class="tag-row">
                    {p.topics.slice(0, 3).map((t: string) => <Tag label={t} />)}
                  </div>
                </div>
              )}
              <div class="meta-group">
                <span class="meta-label">{tech.meta_languages}</span>
                <div class="tag-row">
                  {p.languages.slice(0, 3).map((l) => (
                    <span class="lang-tag">
                      <span class="lang-dot" style={`background:${l.color}`} />
                      {l.name} <span class="lang-pct">{l.percentage}%</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="work-divider container" data-section-divider="creative"></div>

    <!-- ── Creative ───────────────────────────────────── -->
    <section class="work-section container" data-section="creative" id="section-creative">
      <div class="work-section-label">
        <h2 class="work-section-title">{creative.title}</h2>
      </div>

      <!-- Photography -->
      <div class="creative-block" data-creative="photography" id="block-photography">
        <div class="creative-block-header">
          <h3 class="creative-block-title">
            <span class="creative-tag">{creative.photography.tag}</span>
            {creative.photography.title}
          </h3>
          <a href={links.behance} class="behance-link" target="_blank" rel="noopener noreferrer">{creative.photography.behance_label}</a>
        </div>
        <div class="photo-grid">
          {creative.photography.placeholders.map((item: any) => (
            <div class="photo-card">
              {item.src && <img src={item.src} alt={item.label} class="photo-img" loading="lazy" />}
              <span class="photo-label">{item.label}</span>
            </div>
          ))}
        </div>
        <p class="creative-note">{creative.photography.note}</p>
      </div>

      <!-- Illustration -->
      {sections.illustration && <div class="creative-block" data-creative="illustration" id="block-illustration">
        <div class="creative-block-header">
          <h3 class="creative-block-title">
            <span class="creative-tag">{creative.illustration.tag}</span>
            {creative.illustration.title}
          </h3>
          <a href={links.behance} class="behance-link" target="_blank" rel="noopener noreferrer">{creative.illustration.behance_label}</a>
        </div>
        <div class="illus-grid">
          {creative.illustration.placeholders.map((label: string) => (
            <div class="illus-card">
              <span class="illus-label">{label}</span>
            </div>
          ))}
        </div>
        <p class="creative-note">{creative.illustration.note}</p>
      </div>}

      <!-- Music -->
      <div class="creative-block" data-creative="music" id="block-music">
        <h3 class="creative-block-title">
          <span class="creative-tag">{creative.music.tag}</span>
          {creative.music.title}
        </h3>
        <div class="music-block">
          <div class="music-desc">
            <p>{creative.music.p1}</p>
            <p>
              {creative.music.p2_prefix} <a href={`mailto:${links.email}`}>{creative.music.p2_link}</a>.
            </p>
            <div class="music-ctas">
              <a href={links.youtube} class="music-cta" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                {creative.music.cta_youtube}
              </a>
              <a href={links.soundcloud} class="music-cta music-cta--ghost" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.175 12.225c-.015 0-.023.01-.023.025l-.323 2.017.323 1.973c0 .015.008.025.023.025.014 0 .023-.01.023-.025l.366-1.973-.366-2.017c0-.015-.01-.025-.023-.025zm.984-.607c-.02 0-.03.013-.03.03l-.28 2.594.28 2.513c0 .018.01.03.03.03.018 0 .03-.012.03-.03l.318-2.513-.318-2.594c0-.017-.012-.03-.03-.03zm1.007-.166c-.024 0-.04.016-.04.04l-.244 2.76.244 2.466c0 .024.016.04.04.04s.04-.016.04-.04l.278-2.466-.278-2.76c0-.024-.016-.04-.04-.04zm1.016.103c-.03 0-.05.02-.05.05l-.207 2.657.207 2.416c0 .03.02.05.05.05s.05-.02.05-.05l.235-2.416-.235-2.657c0-.03-.02-.05-.05-.05zm1.02-.26c-.034 0-.058.024-.058.058l-.171 2.917.171 2.363c0 .034.024.058.058.058s.058-.024.058-.058l.195-2.363-.195-2.917c0-.034-.024-.058-.058-.058zm1.025-.128c-.038 0-.066.028-.066.066l-.135 3.045.135 2.31c0 .038.028.066.066.066s.066-.028.066-.066l.153-2.31-.153-3.045c0-.038-.028-.066-.066-.066zm1.033-.042c-.043 0-.076.033-.076.076l-.098 3.087.098 2.257c0 .043.033.076.076.076s.076-.033.076-.076l.112-2.257-.112-3.087c0-.043-.033-.076-.076-.076zm1.042.094c-.048 0-.084.036-.084.084l-.062 2.993.062 2.203c0 .048.036.084.084.084s.084-.036.084-.084l.07-2.203-.07-2.993c0-.048-.036-.084-.084-.084zm1.05.32c-.052 0-.092.04-.092.092l-.025 2.673.025 2.148c0 .052.04.092.092.092s.092-.04.092-.092l.028-2.148-.028-2.673c0-.052-.04-.092-.092-.092zm1.058.484c-.057 0-.1.043-.1.1v.001l.012 2.189-.012 2.092c0 .057.043.1.1.1s.1-.043.1-.1l.014-2.092-.014-2.19c0-.057-.043-.1-.1-.1zm4.68-2.972c-.285 0-.56.05-.814.14-.168-1.9-1.762-3.384-3.706-3.384-.505 0-.986.103-1.42.288-.164.065-.208.13-.21.194v6.594c.002.067.055.12.12.126h6.03c.51 0 .924-.413.924-.924v-.002c0-.51-.413-.924-.924-.924z"/></svg>
                {creative.music.cta_soundcloud}
              </a>
            </div>
          </div>
          {creative.music.embed ? (
            <div class="music-embed-wrap">
              <iframe
                src={creative.music.embed}
                class="music-embed"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                title={creative.music.title}
              />
            </div>
          ) : (
            <div class="music-placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18V5l12-2v13"/>
                <circle cx="6" cy="18" r="3"/>
                <circle cx="18" cy="16" r="3"/>
              </svg>
              <span>{creative.music.placeholder}</span>
            </div>
          )}
        </div>
      </div>

    </section>

  </div>
</BaseLayout>

<style>
  .work-page {
    padding-bottom: 6rem;
  }

  .work-header {
    padding-block: 4rem 0;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.875rem;
  }

  .work-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .work-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 2.5rem;
    max-width: 480px;
  }

  .filter-tabs {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.375rem 1rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .filter-tab:hover {
    color: var(--color-text);
    background: var(--color-bg-muted);
  }

  .filter-tab.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .work-section {
    margin-bottom: 3rem;
  }

  .work-section-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .work-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--color-text);
  }

  .gh-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .gh-link:hover {
    opacity: 0.75;
  }

  .work-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 3rem;
  }

  .tech-featured {
    display: block;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg-card));
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: 1.5rem;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .tech-featured:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.07);
  }

  .featured-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .tech-featured-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    color: var(--color-text);
    margin-bottom: 0.25rem;
    letter-spacing: -0.015em;
  }

  .tech-featured-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .tech-featured-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 1rem;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .tech-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }

  .tech-card-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .repo-stats {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.875rem;
  }

  .repo-stats--compact {
    margin-bottom: 0;
    margin-top: 0.2rem;
  }

  .stat-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .stat-sep {
    font-size: 0.75rem;
    color: var(--color-border);
  }

  .archived-badge {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.5em;
    border-radius: 0.25rem;
  }

  .tech-card-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .tech-card-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
  }

  .tech-meta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: auto;
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .lang-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.2rem 0.625rem;
  }

  .lang-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .lang-pct {
    opacity: 0.65;
    font-size: 0.75rem;
  }

  .creative-block {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .creative-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .creative-block-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .creative-block-header .creative-block-title {
    margin-bottom: 0;
  }

  .behance-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    white-space: nowrap;
    transition: opacity 0.15s;
    text-decoration: none;
  }

  .behance-link:hover {
    opacity: 0.75;
  }

  .creative-block-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--color-text);
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .creative-tag {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
  }

  .creative-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .photo-grid {
