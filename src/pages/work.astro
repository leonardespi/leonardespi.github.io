---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';
import { getSiteContent } from '../i18n/utils';

const site = getSiteContent('en');
const { pages, links } = site;
const work = pages.work;
const tech = work.technical;
const creative = work.creative;
---

<BaseLayout title={work.meta.title} description={work.meta.description}>
  <div class="work-page">

    <div class="work-header container">
      <p class="eyebrow">{work.header.eyebrow}</p>
      <h1 class="work-title">{work.header.title}</h1>
      <p class="work-subtitle">{work.header.subtitle}</p>

      <div class="filter-tabs" role="tablist" aria-label="Filter work by category">
        <button class="filter-tab is-active" data-filter="all" role="tab" aria-selected="true" type="button">{work.filters.all}</button>
        <button class="filter-tab" data-filter="technical" role="tab" aria-selected="false" type="button">{work.filters.technical}</button>
        <button class="filter-tab" data-filter="photography" role="tab" aria-selected="false" type="button">{work.filters.photography}</button>
        <button class="filter-tab" data-filter="illustration" role="tab" aria-selected="false" type="button">{work.filters.illustration}</button>
        <button class="filter-tab" data-filter="music" role="tab" aria-selected="false" type="button">{work.filters.music}</button>
      </div>
    </div>

    <!-- ── Technical ──────────────────────────────────── -->
    <section class="work-section container" data-section="technical" id="section-technical">
      <div class="work-section-label">
        <h2 class="work-section-title">{tech.title}</h2>
        <a href={links.github} class="gh-link" target="_blank" rel="noopener noreferrer">
          {tech.gh_label}
        </a>
      </div>

      {tech.projects.filter((p: any) => p.featured).map((p: any) => (
        <a href={p.href} class="tech-featured" target="_blank" rel="noopener noreferrer">
          <span class="featured-badge">{tech.featured_label}</span>
          <h3 class="tech-featured-name">{p.name}</h3>
          <p class="tech-featured-tagline">{p.tagline}</p>
          <p class="tech-featured-desc">{p.description}</p>
          <div class="tag-row">
            {p.tags.map((t: string) => <Tag label={t} color="accent" />)}
          </div>
        </a>
      ))}

      <div class="tech-grid">
        {tech.projects.filter((p: any) => !p.featured).map((p: any) => (
          <a href={p.href} class="tech-card" target="_blank" rel="noopener noreferrer">
            <div>
              <h3 class="tech-card-name">{p.name}</h3>
              <p class="tech-card-tagline">{p.tagline}</p>
            </div>
            <p class="tech-card-desc">{p.description}</p>
            <div class="tag-row">
              {p.tags.map((t: string) => <Tag label={t} />)}
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="work-divider container" data-section-divider="creative"></div>

    <!-- ── Creative ───────────────────────────────────── -->
    <section class="work-section container" data-section="creative" id="section-creative">
      <div class="work-section-label">
        <h2 class="work-section-title">{creative.title}</h2>
      </div>

      <!-- Photography -->
      <div class="creative-block" data-creative="photography" id="block-photography">
        <h3 class="creative-block-title">
          <span class="creative-tag">{creative.photography.tag}</span>
          {creative.photography.title}
        </h3>
        <div class="photo-grid">
          {creative.photography.placeholders.map((label: string) => (
            <div class="photo-card">
              <span class="photo-label">{label}</span>
            </div>
          ))}
        </div>
        <p class="creative-note">{creative.photography.note}</p>
      </div>

      <!-- Illustration -->
      <div class="creative-block" data-creative="illustration" id="block-illustration">
        <h3 class="creative-block-title">
          <span class="creative-tag">{creative.illustration.tag}</span>
          {creative.illustration.title}
        </h3>
        <div class="illus-grid">
          {creative.illustration.placeholders.map((label: string) => (
            <div class="illus-card">
              <span class="illus-label">{label}</span>
            </div>
          ))}
        </div>
        <p class="creative-note">{creative.illustration.note}</p>
      </div>

      <!-- Music -->
      <div class="creative-block" data-creative="music" id="block-music">
        <h3 class="creative-block-title">
          <span class="creative-tag">{creative.music.tag}</span>
          {creative.music.title}
        </h3>
        <div class="music-block">
          <div class="music-desc">
            <p>{creative.music.p1}</p>
            <p>
              {creative.music.p2_prefix} <a href={`mailto:${links.email}`}>{creative.music.p2_link}</a>.
            </p>
          </div>
          <div class="music-placeholder">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
            <span>{creative.music.placeholder}</span>
          </div>
        </div>
      </div>

    </section>

  </div>
</BaseLayout>

<style>
  .work-page {
    padding-bottom: 6rem;
  }

  .work-header {
    padding-block: 4rem 0;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.875rem;
  }

  .work-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .work-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 2.5rem;
    max-width: 480px;
  }

  .filter-tabs {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.375rem 1rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .filter-tab:hover {
    color: var(--color-text);
    background: var(--color-bg-muted);
  }

  .filter-tab.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .work-section {
    margin-bottom: 3rem;
  }

  .work-section-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .work-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--color-text);
  }

  .gh-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .gh-link:hover {
    opacity: 0.75;
  }

  .work-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 3rem;
  }

  .tech-featured {
    display: block;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg-card));
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: 0.875rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: 1.5rem;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .tech-featured:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.07);
  }

  .featured-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .tech-featured-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    color: var(--color-text);
    margin-bottom: 0.25rem;
    letter-spacing: -0.015em;
  }

  .tech-featured-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .tech-featured-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 1rem;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .tech-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }

  .tech-card-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .tech-card-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .tech-card-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .creative-block {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .creative-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .creative-block-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .creative-tag {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
  }

  .creative-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .photo-card {
    position: relative;
    aspect-ratio: 4/3;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-card));
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 0.625rem;
    transition: transform 0.15s, box-shadow 0.15s;
    cursor: default;
  }

  .photo-card:hover {
    transform: scale(1.01);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  }

  .photo-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 0.2rem;
  }

  .illus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .illus-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .illus-card {
    position: relative;
    aspect-ratio: 3/4;
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg-card));
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 0.625rem;
    transition: transform 0.15s, box-shadow 0.15s;
    cursor: default;
  }

  .illus-card:hover {
    transform: scale(1.01);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  }

  .illus-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 0.2rem;
  }

  .music-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .music-block {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
    }

    .music-desc {
      flex: 1;
    }
  }

  .music-desc {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .music-desc p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .music-desc a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .music-desc a:hover {
    text-decoration-color: var(--color-accent);
  }

  .music-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    min-width: 200px;
    background: var(--color-bg-card);
    border: 1px dashed var(--color-border);
    border-radius: 0.625rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .is-hidden {
    display: none;
  }
</style>

<script>
  function initWorkFilter() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const technicalSection = document.getElementById('section-technical');
    const creativeSection  = document.getElementById('section-creative');
    const creativeDivider  = document.querySelector('[data-section-divider="creative"]');
    const photoBlock       = document.getElementById('block-photography');
    const illusBlock       = document.getElementById('block-illustration');
    const musicBlock       = document.getElementById('block-music');

    if (!tabs.length) return;

    const allCreative = [photoBlock, illusBlock, musicBlock];

    const reset = () => {
      [technicalSection, creativeSection, creativeDivider, ...allCreative].forEach(el => {
        el?.classList.remove('is-hidden');
      });
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;
        reset();

        if (filter === 'technical') {
          creativeSection?.classList.add('is-hidden');
          creativeDivider?.classList.add('is-hidden');
        } else if (filter === 'photography') {
          technicalSection?.classList.add('is-hidden');
          creativeDivider?.classList.add('is-hidden');
          illusBlock?.classList.add('is-hidden');
          musicBlock?.classList.add('is-hidden');
        } else if (filter === 'illustration') {
          technicalSection?.classList.add('is-hidden');
          creativeDivider?.classList.add('is-hidden');
          photoBlock?.classList.add('is-hidden');
          musicBlock?.classList.add('is-hidden');
        } else if (filter === 'music') {
          technicalSection?.classList.add('is-hidden');
          creativeDivider?.classList.add('is-hidden');
          photoBlock?.classList.add('is-hidden');
          illusBlock?.classList.add('is-hidden');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initWorkFilter);
</script>
