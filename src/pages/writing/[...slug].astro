---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, index) => {
    const newerPost = index > 0 ? sorted[index - 1] : null;
    const olderPost = index < sorted.length - 1 ? sorted[index + 1] : null;

    // Related posts: ranked by shared tag count, then by date, max 3
    const related = sorted
      .filter(p => p.id !== post.id)
      .map(p => ({
        post: p,
        shared: p.data.tags.filter(t => post.data.tags.includes(t)).length,
      }))
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => b.shared - a.shared || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map(({ post: p }) => ({
        id: p.id,
        title: p.data.title,
        description: p.data.description,
        date: p.data.date,
        tags: p.data.tags,
      }));

    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: olderPost
          ? { title: olderPost.data.title, id: olderPost.id }
          : null,
        nextPost: newerPost
          ? { title: newerPost.data.title, id: newerPost.id }
          : null,
        relatedPosts: related,
      },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await render(post);

// ── Reading time ──────────────────────────────────────────────────
// Strip markdown syntax, count words, calculate at ~200 wpm
function estimateReadingTime(body: string): number {
  const text = body
    .replace(/```[\s\S]*?```/g, '')    // fenced code blocks
    .replace(/`[^`]+`/g, '')           // inline code
    .replace(/!\[.*?\]\(.*?\)/g, '')   // images
    .replace(/\[.*?\]\(.*?\)/g, '$1') // links (keep text)
    .replace(/#{1,6}\s/g, '')          // headings
    .replace(/[*_~>|`#\-]/g, '')      // misc markdown chars
    .trim();

  const wordCount = text.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}

const readingTime = estimateReadingTime(post.body ?? '');
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  image={post.data.image}
  readingTime={readingTime}
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
  postLang={post.data.lang}
>
  <Content />
</BlogLayout>
