---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/ui/Tag.astro';
import Hero from '../../components/sections/Hero.astro';
import Button from '../../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { getSiteContent, WRITING_PATH, prefix } from '../../i18n/utils';

const site = getSiteContent('es');
const { pages, links, index: sections } = site;
const home = pages.home;
const p = prefix('es');

const { frontmatter: nowData } = await import('../../content/now/es.md');
const nowWidget = nowData.widget;

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'es');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

---

<BaseLayout description={home.meta.description}>
  {sections.hero && (
    <Hero
      variant="home"
      eyebrow={home.hero.eyebrow}
      title={home.hero.title}
      subtitle={home.hero.subtitle}
      trajectory={home.hero.trajectory}
      ctas={home.hero.ctas}
    />
  )}

  {(sections.available_for || sections.now_feed) && (
    <section class="section section--widgets">
      <div class="container">
        <div class="widgets-grid">

          {sections.available_for && (
            <div class="widget-card widget-card--available">
              <p class="available-label">{home.available_for.label}</p>
              <ul class="available-list">
                {home.available_for.items.map((item: any) => (
                  <li>
                    <span class="arrow">→</span> {item.text}
                    {item.detail && <span class="detail">{item.detail}</span>}
                  </li>
                ))}
              </ul>
              <a href={`mailto:${links.email}`} class="available-cta">
                {home.available_for.cta}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          )}

          {sections.now_feed && (
            <div class="widget-card widget-card--now">
              <div class="now-badge">
                <span class="now-pulse" aria-hidden="true"></span>
                {nowWidget.badge}
              </div>
              <div class="now-snapshot">
                {nowWidget.rows.map((row: any) => (
                  <div class="now-row">
                    <span class="now-row-label">{row.label}</span>
                    <span class="now-row-value" set:html={row.value} />
                  </div>
                ))}
              </div>
              <span class="now-updated">{nowWidget.updated}</span>
              <a href="/es/now" class="now-cta">{nowWidget.link}</a>
            </div>
          )}

        </div>
      </div>
    </section>
  )}

  {sections.recent_writing && recentPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{home.writing.title}</h2>
          <a href={`${p}${WRITING_PATH}`} class="section-link">{home.writing.all}</a>
        </div>
        <div class="posts-list">
          {recentPosts.map((post) => (
            <a href={`${WRITING_PATH}/${post.id}`} class="post-item">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()} class="post-date">
                  {post.data.date.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {post.data.tags.slice(0, 2).map(tag => <Tag label={tag} />)}
              </div>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-description">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {sections.dual_identity && (
    <section class="section section--identity">
      <div class="container">
        <div class="identity-inner">
          <div class="identity-text">
            <h2 class="section-title">{home.dual_identity.title}</h2>
            <p class="identity-copy">{home.dual_identity.copy}</p>
            <a href="/es/work" class="section-link">{home.dual_identity.link}</a>
          </div>
          <div class="identity-samples">
            {home.dual_identity.samples.map((s: any) => (
              <div class={`sample-card sample-card--${s.key}`}>
                {s.type === 'youtube' && s.src && (
                  <iframe
                    src={s.src}
                    class="sample-embed"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    title={s.label}
                  />
                )}
                {s.type === 'image' && s.src && (
                  <img src={s.src} alt={s.label} class="sample-image" loading="lazy" />
                )}
                <span class="sample-label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {sections.cta && (
    <section class="section section--cta">
      <div class="container">
        <div class="cta-inner">
          <div>
            <h2 class="cta-title">{home.cta.title}</h2>
            <p class="cta-body">{home.cta.body}</p>
          </div>
          <div class="cta-actions">
            <Button href={links.cv} variant="primary">{home.cta.resume}</Button>
            <Button href={`mailto:${links.email}`} variant="ghost">{home.cta.contact}</Button>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .section--widgets { background: var(--color-bg-muted); border-bottom: 1px solid var(--color-border); }
  .widgets-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 720px) { .widgets-grid { grid-template-columns: 1fr 1fr; align-items: stretch; } }
  .widget-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1.75rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .available-label { font-family: var(--font-display); font-size: clamp(1.125rem, 2.5vw, 1.5rem); color: var(--color-text); }
  .available-list { list-style: none; display: flex; flex-direction: column; gap: 0.625rem; flex: 1; }
  .available-list li { font-size: 1rem; color: var(--color-text-muted); line-height: 1.5; }
  .available-list .arrow { color: var(--color-accent); font-weight: 600; margin-right: 0.5rem; }
  .available-list .detail { font-size: 0.875rem; opacity: 0.75; }
  .available-cta { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--color-accent); color: #fff; font-size: 1rem; font-weight: 500; border-radius: 0.5rem; text-decoration: none; white-space: nowrap; align-self: flex-start; transition: background 0.15s; margin-top: auto; }
  .available-cta:hover { background: var(--color-accent-hover); }
  .now-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); align-self: flex-start; }
  .now-pulse { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.45; transform: scale(0.85); } }
  .now-snapshot { display: flex; flex-direction: column; gap: 0.625rem; border-left: 2px solid color-mix(in srgb, var(--color-accent) 30%, transparent); padding-left: 1.25rem; }
  .now-row { display: flex; flex-direction: column; gap: 0.125rem; }
  @media (min-width: 600px) { .now-row { flex-direction: row; gap: 1rem; } .now-row-label { flex-shrink: 0; width: 115px; } }
  .now-row-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-muted); opacity: 0.75; }
  .now-row-value { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.5; }
  .now-updated { font-size: 0.8125rem; color: var(--color-text-muted); opacity: 0.65; }
  .now-cta { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border); font-family: var(--font-body); font-size: 1rem; font-weight: 500; border-radius: 0.5rem; text-decoration: none; white-space: nowrap; align-self: flex-start; transition: background 0.15s, border-color 0.15s; margin-top: auto; }
  .now-cta:hover { background: var(--color-bg-muted); border-color: var(--color-text-muted); }
  .section--identity { background: var(--color-bg-muted); }
  .identity-inner { display: flex; flex-direction: column; gap: 2.5rem; }
  @media (min-width: 900px) { .identity-inner { flex-direction: row; align-items: flex-start; gap: 3rem; } .identity-text { flex: 0 0 400px; } }
  .identity-copy { font-size: 1.0625rem; color: var(--color-text-muted); line-height: 1.75; margin-block: 1rem 1.5rem; }
  .identity-samples { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.875rem; flex: 1; }
  .sample-card { position: relative; aspect-ratio: 3/4; border-radius: 0.625rem; border: 1px solid var(--color-border); overflow: hidden; display: flex; align-items: flex-end; padding: 0.875rem; }
  .sample-card--photo { background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg-card)); }
  .sample-card--illustration { background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-card)); }
  .sample-card--music { background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg-card)); }
  .sample-embed, .sample-image { position: absolute; inset: 0; width: 100%; height: 100%; border: none; object-fit: cover; }
  .sample-label { position: relative; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); background: color-mix(in srgb, var(--color-bg) 85%, transparent); padding: 0.25rem 0.5rem; border-radius: 0.25rem; z-index: 1; }
  .section { padding-block: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--color-border); }
  .section--cta { background: transparent; border-bottom: none; }
  .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2.5rem; gap: 1rem; }
  .section-title { font-family: var(--font-display); font-size: clamp(1.375rem, 3vw, 1.75rem); color: var(--color-text); }
  .section-link { font-size: 0.875rem; color: var(--color-accent); white-space: nowrap; transition: opacity 0.15s; }
  .section-link:hover { opacity: 0.75; }
  .posts-list { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--color-border); }
  .post-item { display: block; padding-block: 1.75rem; border-bottom: 1px solid var(--color-border); text-decoration: none; transition: background 0.15s; margin-inline: -1rem; padding-inline: 1rem; border-radius: 0.5rem; }
  .post-item:hover { background: var(--color-bg-muted); }
  .post-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .post-date { font-size: 0.8125rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .post-title { font-family: var(--font-display); font-size: 1.25rem; color: var(--color-text); margin-bottom: 0.375rem; line-height: 1.3; transition: color 0.15s; }
  .post-item:hover .post-title { color: var(--color-accent); }
  .post-description { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.5; text-align: justify; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cta-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; padding-block: 1rem; }
  @media (min-width: 768px) { .cta-inner { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; } }
  .cta-title { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); color: var(--color-text); margin-bottom: 0.75rem; }
  .cta-body { font-size: 1rem; color: var(--color-text-muted); max-width: 520px; line-height: 1.6; }
  .cta-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .cta-actions > :global(a) { justify-content: center; }
</style>
