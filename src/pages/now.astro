---
import BaseLayout from '../layouts/BaseLayout.astro';

const { frontmatter, Content } = await import('../content/now/en.md');
const { meta, header } = frontmatter;
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="now-page container--narrow container">

    <header class="now-header">
      <div class="now-meta">
        <span class="now-updated">{header.last_updated}</span>
        <span class="now-location">{header.location}</span>
      </div>
      <h1 class="now-title">{header.title}</h1>
      <p class="now-about">
        {header.about.before_link} <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">{header.about.link_text}</a>{header.about.after_link}
      </p>
    </header>

    <div class="now-content">
      <Content />
    </div>

  </div>
</BaseLayout>

<style>
  .now-page {
    padding-block: 4rem 6rem;
  }

  .now-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .now-meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .now-location {
    margin-left: 0.25rem;
  }

  .now-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .now-about {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 520px;
  }

  .now-about a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .now-about a:hover {
    text-decoration-color: var(--color-accent);
  }

  /* Markdown body */
  .now-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .now-content :global(h2) {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .now-content :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .now-content :global(p) {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 0.875rem;
    padding-bottom: 0;
  }

  .now-content :global(p:last-of-type) {
    margin-bottom: 2rem;
  }

  .now-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .now-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  .now-content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }
</style>
