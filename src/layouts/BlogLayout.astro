---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/ui/Tag.astro';

interface AdjacentPost {
  title: string;
  id: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date | string;
  tags?: string[];
  image?: string;
  readingTime?: number;
  prevPost?: AdjacentPost | null;
  nextPost?: AdjacentPost | null;
}

const {
  title,
  description,
  date,
  tags = [],
  image,
  readingTime,
  prevPost = null,
  nextPost = null,
} = Astro.props;

const dateObj = new Date(date);

const formattedDate = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  article={true}
  publishedDate={dateObj.toISOString()}
>
  <div class="container container--narrow" style="padding-block: 4rem;">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog">Blog</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <!-- Article header -->
    <header class="post-header">
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <Tag label={tag} />)}
        </div>
      )}
      <h1 class="post-title">{title}</h1>
      {description && (
        <p class="post-description">{description}</p>
      )}
      <div class="post-meta">
        <time datetime={dateObj.toISOString()}>
          {formattedDate}
        </time>
        {readingTime && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
          </>
        )}
      </div>
    </header>

    <!-- Headliner image -->
    {image && (
      <div class="post-headliner">
        <img
          src={image}
          alt=""
          class="post-headliner-img"
          loading="eager"
          decoding="async"
          onerror="this.closest('.post-headliner').remove()"
        />
      </div>
    )}

    <!-- Article body -->
    <article class="prose">
      <slot />
    </article>

    <!-- Post navigation: prev / next -->
    <nav class="post-nav" aria-label="Post navigation">
      <div class="post-nav-inner">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}`} class="post-nav-item post-nav-item--prev">
            <span class="post-nav-label">← Older</span>
            <span class="post-nav-title">{prevPost.title}</span>
          </a>
        ) : (
          <div />
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}`} class="post-nav-item post-nav-item--next">
            <span class="post-nav-label">Newer →</span>
            <span class="post-nav-title">{nextPost.title}</span>
          </a>
        ) : (
          <div />
        )}
      </div>
      <div class="post-nav-back">
        <a href="/blog">← All posts</a>
      </div>
    </nav>

  </div>
</BaseLayout>

<style>
  /* Breadcrumb */
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .breadcrumb a:hover {
    opacity: 0.75;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Post header */
  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    text-align: justify;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .meta-sep {
    color: var(--color-border);
  }

  /* Headliner image */
  .post-headliner {
    margin-bottom: 3rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .post-headliner-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* Post navigation */
  .post-nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .post-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .post-nav-item:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-muted);
  }

  .post-nav-item--next {
    text-align: right;
    margin-left: auto;
  }

  .post-nav-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .post-nav-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-nav-back {
    text-align: center;
  }

  .post-nav-back a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-nav-back a:hover {
    color: var(--color-accent);
  }
</style>
